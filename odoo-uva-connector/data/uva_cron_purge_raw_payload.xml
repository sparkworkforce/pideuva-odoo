<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_uva_purge_order_payload" model="ir.cron">
            <field name="name">Uva PR: Purge Order Raw Payloads (30 days)</field>
            <field name="model_id" ref="model_uva_order_log"/>
            <field name="state">code</field>
            <field name="code">model.purge_raw_payloads()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:00:00')"/>
        </record>

        <record id="ir_cron_uva_purge_retry_payload" model="ir.cron">
            <field name="name">Uva PR: Purge Retry Queue Payloads (30 days)</field>
            <field name="model_id" ref="model_uva_api_retry_queue"/>
            <field name="state">code</field>
            <field name="code">model.purge_done_payloads()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:30:00')"/>
        </record>
    </data>
</odoo>
